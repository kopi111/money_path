      "html": "<div class=\"ds-total\"><span class=\"ds-total-label\">Left</span><span class=\"ds-total-sum\">$60,830</span></div>",
      "css": ".ds-total{font-family:'Atkinson Hyperlegible Next',sans-serif;display:flex;justify-content:space-between;align-items:flex-end;padding:10px 16px 12px 68px;border-bottom:1px solid #15245C;background:#FBFCFA;color:#15245C}.ds-total-label{font-size:20px;font-weight:700}.ds-total-sum{font-size:26px;font-weight:700;font-variant-numeric:tabular-nums;padding-bottom:4px;border-bottom:4px double #15245C;min-width:120px;text-align:right}"
    },
    {
      "name": "Goal Cover",
      "kind": "card",
      "refersTo": "goal-cover",
      "description": "A goal as a solid exercise-book cover with the NAME / BY label plate, hero amount, outlined progress bar and status plate.",
      "html": "<div class=\"ds-cover\"><div class=\"ds-plate\"><div class=\"ds-plate-line\"><small>NAME</small><strong>Christmas</strong></div><div class=\"ds-plate-line\"><small>BY</small><span>20 Dec 2026 · fortnightly</span></div></div><div class=\"ds-cover-amount\">$9,000</div><div class=\"ds-cover-sub\">saved of $50,000 · 18%</div><div class=\"ds-cover-bar\"><i style=\"width:18%\"></i></div><div class=\"ds-status\"><span class=\"ds-status-text\"><b>Slightly behind</b>  ·  $1,000 behind</span><span class=\"ds-status-rule\"></span></div></div>",
      "css": ".ds-cover{font-family:'Atkinson Hyperlegible Next',sans-serif;background:#6A3AA8;color:#fff;border-radius:6px;padding:16px 16px 18px;cursor:pointer;transition:filter .2s}.ds-cover:hover{filter:brightness(1.06)}.ds-cover:focus-visible{outline:3px solid #15245C;outline-offset:2px}.ds-plate{background:#fff;color:#15245C;border-radius:10px;padding:10px 14px}.ds-plate-line{display:flex;align-items:baseline;gap:10px;padding-bottom:4px;border-bottom:1px solid #C7D6EB;margin-bottom:6px}.ds-plate-line small{font-size:12px;font-weight:600;letter-spacing:.8px;color:#475377}.ds-plate-line strong{font-size:20px}.ds-cover-amount{margin-top:18px;font-size:44px;font-weight:800;line-height:1.08;font-variant-numeric:tabular-nums}.ds-cover-sub{font-size:15px;font-weight:600}.ds-cover-bar{margin:12px 0 14px;height:10px;border:1.5px solid #fff;border-radius:2px;box-sizing:border-box}.ds-cover-bar i{display:block;height:100%;background:#fff}.ds-status{display:inline-block;background:#fff;border-radius:8px;padding:8px 12px 6px 10px;color:#8F5B00;font-size:15px;font-weight:600}.ds-status b{font-weight:800}.ds-status-rule{display:block;width:96px;height:0;margin-top:4px;border-top:2px dashed #8F5B00}"
