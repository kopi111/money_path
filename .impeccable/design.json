      "html": "<button class=\"ds-btn-primary\">Add income</button>",
      "css": ".ds-btn-primary{font-family:'Atkinson Hyperlegible Next',sans-serif;width:100%;height:56px;border:none;border-radius:999px;background:#15245C;color:#FBFCFA;font-size:15px;font-weight:600;cursor:pointer;transition:background .2s}.ds-btn-primary:hover{background:#22347A}.ds-btn-primary:focus-visible{outline:3px solid #C7D6EB;outline-offset:2px}"
    },
