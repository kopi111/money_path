      "html": "<button class=\"ds-btn-outline\">Take out</button>",
      "css": ".ds-btn-outline{font-family:'Atkinson Hyperlegible Next',sans-serif;height:52px;padding:0 24px;border:1px solid #475377;border-radius:999px;background:transparent;color:#15245C;font-size:15px;font-weight:600;cursor:pointer}.ds-btn-outline:hover{background:rgba(199,214,235,.35)}.ds-btn-outline:focus-visible{outline:3px solid #C7D6EB;outline-offset:2px}"
    },
    {
      "name": "Ledger Row",
      "kind": "custom",
      "refersTo": "ledger-row",
      "description": "One line of the book on its own feint rule: date in the red margin, amount in the sum column.",
      "html": "<div class=\"ds-page\"><div class=\"ds-row\"><div class=\"ds-row-margin\"><b>24</b><span>Sep</span></div><div class=\"ds-row-text\"><div class=\"ds-row-title\">JPS light bill</div><div class=\"ds-row-sub\">Due in 5 days</div></div><div class=\"ds-row-amount\">$9,800</div></div></div>",
      "css": ".ds-page{font-family:'Atkinson Hyperlegible Next',sans-serif;background:#FBFCFA;color:#15245C;background-image:linear-gradient(90deg,transparent 56px,rgba(217,72,59,.85) 56px,rgba(217,72,59,.85) 57.25px,transparent 57.25px,transparent 59px,rgba(217,72,59,.85) 59px,rgba(217,72,59,.85) 60.25px,transparent 60.25px)}.ds-row{display:flex;align-items:center;min-height:64px;border-bottom:1px solid #C7D6EB;cursor:pointer}.ds-row:hover{background:rgba(199,214,235,.25)}.ds-row:focus-visible{outline:2px solid #15245C}.ds-row-margin{width:56px;display:flex;flex-direction:column;align-items:center;color:#D9483B}.ds-row-margin b{font-size:17px;font-weight:700}.ds-row-margin span{font-size:12px;font-weight:600}.ds-row-text{flex:1;margin-left:12px;padding:10px 0}.ds-row-title{font-size:17px;line-height:1.4}.ds-row-sub{font-size:13px;color:#475377}.ds-row-amount{margin:0 16px 0 12px;font-size:17px;font-weight:700;font-variant-numeric:tabular-nums}"
    },
    {
